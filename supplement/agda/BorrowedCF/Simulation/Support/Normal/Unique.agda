-- | Uniqueness of the normal form.
--
--   The headline of the normalisation theory: two normal forms whose pluggings
--   are structurally congruent are related by `~`, the concrete equivalence
--   generated by binder transpositions, thread permutation, and deletion of the
--   spent `unit`.  Together with Normal.Complete's converse this says `~` and
--   `≋` are the same relation, read through `nf` / `⌈_⌉`.
--
--   What makes it usable for the reverse simulation is that `~` is CONCRETE: a
--   derivation hands back an explicit renaming on the threads, so a redex
--   located in one normal form can be located in the other.  `≋` on its own
--   cannot do that — its φ-escape (`νφ-comm′`) is exactly what refutes the
--   strict image-inversion route (Simulation.RevUCong.reverse-U-≋-⊥).
module BorrowedCF.Simulation.Support.Normal.Unique where

open import BorrowedCF.Prelude
open import BorrowedCF.Processes.Untyped
open import BorrowedCF.Simulation.Support.Normal.Form
open import BorrowedCF.Simulation.Support.Normal.Norm using (nf; nf-sound)
open import BorrowedCF.Simulation.Support.Normal.Equiv
open import BorrowedCF.Simulation.Support.Normal.Idem using (nf-⌈⌉)
open import BorrowedCF.Simulation.Support.Normal.Sound using (≋⇒~)
open import BorrowedCF.Simulation.Support.Normal.Complete using (~⇒≋)
open import BorrowedCF.Simulation.Support.Normal.Prenex using (≋-sym)

open import Relation.Binary.Construct.Closure.ReflexiveTransitive using (_◅◅_)

open Nat.Variables

nf-unique : ∀ {n} (N₁ N₂ : NF n) → ⌈ N₁ ⌉ ≋ ⌈ N₂ ⌉ → N₁ ~ N₂
nf-unique N₁ N₂ c = ~-trans (~-sym (nf-⌈⌉ N₁)) (~-trans (≋⇒~ c) (nf-⌈⌉ N₂))

-- The two relations agree.
≋⇔~ : ∀ {n} (N₁ N₂ : NF n) → (⌈ N₁ ⌉ ≋ ⌈ N₂ ⌉ → N₁ ~ N₂) × (N₁ ~ N₂ → ⌈ N₁ ⌉ ≋ ⌈ N₂ ⌉)
≋⇔~ N₁ N₂ = nf-unique N₁ N₂ , ~⇒≋

-- The form the reverse simulation consumes: a ≋ between two processes is a
-- concrete `~` between their normal forms, and each side is ≋ to its own
-- normal form, so the whole chain can be replayed.
≋-nf : ∀ {n} {P Q : Proc n} → P ≋ Q → (P ≋ ⌈ nf P ⌉) × (nf P ~ nf Q) × (⌈ nf Q ⌉ ≋ Q)
≋-nf {P = P} {Q} c = nf-sound P , ≋⇒~ c , ≋-sym (nf-sound Q)
