-- | The factorisation probe: `~ = ~ᵩ ; ~ᵇ` against a block form.
--
--   Target statement (`factor`): a `~`-relation into a BLOCK normal form
--   factors as a φ-only rearrangement (`~ᵩ`, Normal.FactorBase — absorbed
--   downstream by the up-to-φ relation `≈`) followed by BLOCK-LEVEL moves
--   (`~ᵇ`, this module — realisable on the typed side, where a ν-node
--   travels together with its φ-nest, cf. `U-≋` in Support/Congruence).
--
--   `_~ᵇ_` is generated by
--     * `bswpᵇ`  — transposition of two ADJACENT BLOCKS (a `tν` plus its
--        trailing φ-run travels past the next one, as one unit).  Its
--        composite renaming is explicit and Bubble-style: `bswapRen` =
--        pull the second block's ν out through the first block
--        (`bubν⁻`), then drag its run out cell by cell (`dragRen`).
--        Everything is two-index structural — no scope transport anywhere.
--     * `ν1ᵇ`   — endpoint swap inside one ν  (= `perm-ν1`),
--     * `φφᵇ`   — transposing two adjacent φ cells; adjacent φs always
--        belong to the SAME run, so this is within-run permutation
--        (= `perm-φφ`),
--     * `thrᵇ` / `delᵇ` — thread permutation and spent-unit deletion.
--   All generators are sound into `~` (`~ᵇ⇒~`) and preserve block form in
--   both directions (`~ᵇ-Block`, `~ᵇ-Block⁻`).
--
--   STATUS / OPEN.  `factor` is proved MODULO the single named lemma
--   `BlockBridge` (two block forms that are `~`-related are `~ᵇ`-related),
--   taken as an explicit hypothesis; everything else in this module and in
--   Normal.FactorBase is closed — in particular `~ᵇ⇒~`, both Block-
--   preservation directions, and `φfree-bridge`, which PROVES `BlockBridge`
--   on the φ-free fragment (so the open core is precisely the interaction
--   of φ-cell migration with block moves).  See the extended note at
--   `BlockBridge` below for why it is true, what its proof needs, and why
--   the obvious shortcuts fail.
module BorrowedCF.Simulation.Support.Normal.Factor where

open import BorrowedCF.Prelude
open import BorrowedCF.Terms
open import BorrowedCF.Processes.Untyped
open import BorrowedCF.Simulation.Support.Normal.Form
open import BorrowedCF.Simulation.Support.Normal.Equiv
open import BorrowedCF.Simulation.Support.Normal.Shift using (shift2; shift1; liftId-cong)
open import BorrowedCF.Simulation.Support.Normal.Bubble using (map-⋯-id; map-⋯-cong; ≡→~)
open import BorrowedCF.Simulation.Support.Normal.Nat using (map-fuse)
open import BorrowedCF.Simulation.Support.Normal.FactorBase

open import Data.List using (List; []; _∷_; map)
open import Data.List.Relation.Binary.Permutation.Propositional using (_↭_)
open import Relation.Binary.Construct.Closure.Equivalence using (EqClosure)
import Relation.Binary.Construct.Closure.Equivalence as Eq*
open import Relation.Binary.Construct.Closure.ReflexiveTransitive using (ε; _◅_)
open import Relation.Binary.Construct.Closure.Symmetric using (fwd; bwd)

open Nat.Variables

------------------------------------------------------------------------
-- Prefixing a normal form by a telescope, and the `~` congruence for it.
------------------------------------------------------------------------

prefixNF : ∀ {n j} → Tel n j → NF j → NF n
prefixNF []       N = N
prefixNF (tν s)   N = νNF (prefixNF s N)
prefixNF (tφ f s) N = φNF f (prefixNF s N)

prefixNF-++ᵗ : ∀ {n j} (s : Tel n j) (N : NF j) →
               prefixNF s N ≡ mkNF (s ++ᵗ tel N) (thr N)
prefixNF-++ᵗ []       N = refl
prefixNF-++ᵗ (tν s)   N = cong νNF     (prefixNF-++ᵗ s N)
prefixNF-++ᵗ (tφ f s) N = cong (φNF _) (prefixNF-++ᵗ s N)

~-prefix : ∀ {n j} (s : Tel n j) {N₁ N₂ : NF j} → N₁ ~ N₂ →
           prefixNF s N₁ ~ prefixNF s N₂
~-prefix []       c = c
~-prefix (tν s)   c = ~-νNF (~-prefix s c)
~-prefix (tφ f s) c = ~-φNF (~-prefix s c)

------------------------------------------------------------------------
-- Dragging a run outward past a telescope.
------------------------------------------------------------------------

-- `dragTel S w t` is the telescope after the run `r` (witnessed by `w`),
-- sitting between `S` and `t`, has travelled out past `S` cell by cell:
-- the run's flags end up in front (in order), `S` re-based underneath.
-- Defining it by recursion on the RUN keeps every index structural.
dragTel : ∀ {p j m k} (S : Tel p j) {r : Tel j m} (w : Run r) (t : Tel m k) → Tel p k
dragTel S rnil             t = S ++ᵗ t
dragTel S (rφ {f = f} w)   t = tφ f (dragTel (shift1 S) w t)

-- The composite renaming: one `bubφ⁻` bubble per run cell, each lifted
-- over what is inside it.
dragRen : ∀ {p j m k} (S : Tel p j) {r : Tel j m} (w : Run r) (t : Tel m k) → k →ᵣ k
dragRen S rnil           t = idₖ ⦃ Kᵣ ⦄
dragRen S (rφ {r = r} w) t = liftId (r ++ᵗ t) (bubφ⁻ S) ·ₖ dragRen (shift1 S) w t

drag-sound : ∀ {p j m k} (S : Tel p j) {r : Tel j m} (w : Run r) (t : Tel m k)
             (es : List (Tm k)) →
             mkNF (S ++ᵗ (r ++ᵗ t)) es ~ mkNF (dragTel S w t) (map (_⋯ dragRen S w t) es)
drag-sound S rnil t es =
  ≡→~ (cong (mkNF (S ++ᵗ t)) (sym (map-⋯-id (λ _ → refl) es)))
drag-sound S (rφ {f = f} {r = r} w) t es =
  ~-trans (bubbleφ⁻ f S (r ++ᵗ t) es)
    (~-trans (~-φNF (drag-sound (shift1 S) w t (map (_⋯ liftId (r ++ᵗ t) (bubφ⁻ S)) es)))
             (≡→~ (cong (mkNF (tφ f (dragTel (shift1 S) w t)))
                        (map-fuse (liftId (r ++ᵗ t) (bubφ⁻ S)) (dragRen (shift1 S) w t) es))))

------------------------------------------------------------------------
-- The adjacent-block transposition, Bubble-style.
------------------------------------------------------------------------

-- Two adjacent blocks `(tν a)` (run `a`) and `(tν rb)` (run `rb`) over a
-- tail `t`: the second block travels OUT past the first — first its ν
-- (`bubν⁻ (tν a)`), then its run (`dragRen`).  The result telescope is
-- `tν rb′ ++ᵗ tν a′ ++ᵗ t` computed structurally by `dragTel`.
bswapTel : ∀ {n i m k} (a : Tel (2 + n) i) {rb : Tel (2 + i) m} (w : Run rb)
           (t : Tel m k) → Tel n k
bswapTel a w t = tν (dragTel (tν (shift2 a)) w t)

bswapRen : ∀ {n i m k} (a : Tel (2 + n) i) {rb : Tel (2 + i) m} (w : Run rb)
           (t : Tel m k) → k →ᵣ k
bswapRen a {rb} w t = liftId (rb ++ᵗ t) (bubν⁻ (tν a)) ·ₖ dragRen (tν (shift2 a)) w t

bswap-sound : ∀ {n i m k} (a : Tel (2 + n) i) {rb : Tel (2 + i) m} (w : Run rb)
              (t : Tel m k) (es : List (Tm k)) →
              mkNF (tν (a ++ᵗ tν (rb ++ᵗ t))) es
                ~ mkNF (bswapTel a w t) (map (_⋯ bswapRen a w t) es)
bswap-sound a {rb} w t es =
  ~-trans (bubbleν⁻ (tν a) (rb ++ᵗ t) es)
    (~-trans (~-νNF (drag-sound (tν (shift2 a)) w t
                                (map (_⋯ liftId (rb ++ᵗ t) (bubν⁻ (tν a))) es)))
             (≡→~ (cong (mkNF (bswapTel a w t))
                        (map-fuse (liftId (rb ++ᵗ t) (bubν⁻ (tν a)))
                                  (dragRen (tν (shift2 a)) w t) es))))

------------------------------------------------------------------------
-- Block-level moves.
------------------------------------------------------------------------

data _~ᵇ₁_ {n} : NF n → NF n → Set where

  -- swap the two names bound by a single ν  (= perm-ν1)
  ν1ᵇ : ∀ {j k} (s : Tel n j) (t : Tel (2 + j) k) (es : List (Tm k)) →
    mkNF (s ++ᵗ tν t) es ~ᵇ₁ mkNF (s ++ᵗ tν t) (map (_⋯ liftId t (swapᵣ 1 1)) es)

  -- transpose two adjacent φ cells — always within one run  (= perm-φφ)
  φφᵇ : ∀ {j k} (s : Tel n j) (x y : Flag) (t : Tel (1 + (1 + j)) k) (es : List (Tm k)) →
    mkNF (s ++ᵗ tφ x (tφ y t)) es ~ᵇ₁ mkNF (s ++ᵗ tφ y (tφ x t)) (map (_⋯ liftId t (assocSwapᵣ 1 1)) es)

  -- permute the threads
  thrᵇ : ∀ {k} (t : Tel n k) {es es′ : List (Tm k)} →
    es ↭ es′ → mkNF t es ~ᵇ₁ mkNF t es′

  -- delete a spent `unit` thread
  delᵇ : ∀ {k} (t : Tel n k) (es : List (Tm k)) →
    mkNF t (K `unit ∷ es) ~ᵇ₁ mkNF t es

  -- transpose two adjacent blocks.  `ra`/`w` witness that both runs are
  -- φ-only and `bt` that `t` does not start with a φ — so `rb` really is
  -- the whole run of the second block and blocks travel intact.
  bswpᵇ : ∀ {j i m k} (s : Tel n j) {a : Tel (2 + j) i} (ra : Run a)
          {rb : Tel (2 + i) m} (w : Run rb) {t : Tel m k} (bt : Block t)
          (es : List (Tm k)) →
    mkNF (s ++ᵗ tν (a ++ᵗ tν (rb ++ᵗ t))) es
      ~ᵇ₁ mkNF (s ++ᵗ bswapTel a w t) (map (_⋯ bswapRen a w t) es)

infix 4 _~ᵇ_

_~ᵇ_ : ∀ {n} → NF n → NF n → Set
_~ᵇ_ = EqClosure _~ᵇ₁_

~ᵇ-refl : ∀ {n} {N : NF n} → N ~ᵇ N
~ᵇ-refl = Eq*.reflexive _

~ᵇ-sym : ∀ {n} {N₁ N₂ : NF n} → N₁ ~ᵇ N₂ → N₂ ~ᵇ N₁
~ᵇ-sym = Eq*.symmetric _

~ᵇ-trans : ∀ {n} {N₁ N₂ N₃ : NF n} → N₁ ~ᵇ N₂ → N₂ ~ᵇ N₃ → N₁ ~ᵇ N₃
~ᵇ-trans = Eq*.transitive _

≡→~ᵇ : ∀ {n} {N₁ N₂ : NF n} → N₁ ≡ N₂ → N₁ ~ᵇ N₂
≡→~ᵇ refl = ~ᵇ-refl

------------------------------------------------------------------------
-- Soundness: every block move is a `~`.
------------------------------------------------------------------------

~ᵇ₁⇒~ : ∀ {n} {N₁ N₂ : NF n} → N₁ ~ᵇ₁ N₂ → N₁ ~ N₂
~ᵇ₁⇒~ (ν1ᵇ s t es)     = Eq*.return (perm-ν1 s t es)
~ᵇ₁⇒~ (φφᵇ s x y t es) = Eq*.return (perm-φφ s x y t es)
~ᵇ₁⇒~ (thrᵇ t p)       = Eq*.return (perm-thr t p)
~ᵇ₁⇒~ (delᵇ t es)      = Eq*.return (unit-del t es)
~ᵇ₁⇒~ (bswpᵇ s {a} ra {rb} w {t} bt es) =
  ~-trans (≡→~ (sym (prefixNF-++ᵗ s (mkNF (tν (a ++ᵗ tν (rb ++ᵗ t))) es))))
    (~-trans (~-prefix s (bswap-sound a w t es))
             (≡→~ (prefixNF-++ᵗ s (mkNF (bswapTel a w t) (map (_⋯ bswapRen a w t) es)))))

~ᵇ⇒~ : ∀ {n} {N₁ N₂ : NF n} → N₁ ~ᵇ N₂ → N₁ ~ N₂
~ᵇ⇒~ ε           = ~-refl
~ᵇ⇒~ (fwd g ◅ c) = ~-trans (~ᵇ₁⇒~ g)         (~ᵇ⇒~ c)
~ᵇ⇒~ (bwd g ◅ c) = ~-trans (~-sym (~ᵇ₁⇒~ g)) (~ᵇ⇒~ c)

------------------------------------------------------------------------
-- Block moves preserve block form, in both directions.
------------------------------------------------------------------------

Block-++ᵗ : ∀ {n j k} (s : Tel n j) {X₁ X₂ : Tel j k} →
            (Block X₁ → Block X₂) → Block (s ++ᵗ X₁) → Block (s ++ᵗ X₂)
Block-++ᵗ []       h b = h b
Block-++ᵗ (tν s)   h b = bν
Block-++ᵗ (tφ f s) h ()

~ᵇ₁-Block : ∀ {n} {N₁ N₂ : NF n} → N₁ ~ᵇ₁ N₂ → Block (tel N₁) → Block (tel N₂)
~ᵇ₁-Block (ν1ᵇ s t es)      b = b
~ᵇ₁-Block (φφᵇ s x y t es)  b = Block-++ᵗ s (λ ()) b
~ᵇ₁-Block (thrᵇ t p)        b = b
~ᵇ₁-Block (delᵇ t es)       b = b
~ᵇ₁-Block (bswpᵇ s _ _ _ _) b = Block-++ᵗ s (λ _ → bν) b

~ᵇ₁-Block⁻ : ∀ {n} {N₁ N₂ : NF n} → N₁ ~ᵇ₁ N₂ → Block (tel N₂) → Block (tel N₁)
~ᵇ₁-Block⁻ (ν1ᵇ s t es)      b = b
~ᵇ₁-Block⁻ (φφᵇ s x y t es)  b = Block-++ᵗ s (λ ()) b
~ᵇ₁-Block⁻ (thrᵇ t p)        b = b
~ᵇ₁-Block⁻ (delᵇ t es)       b = b
~ᵇ₁-Block⁻ (bswpᵇ s _ _ _ _) b = Block-++ᵗ s (λ _ → bν) b

~ᵇ-Block : ∀ {n} {N₁ N₂ : NF n} → N₁ ~ᵇ N₂ → Block (tel N₁) → Block (tel N₂)
~ᵇ-Block ε           b = b
~ᵇ-Block (fwd g ◅ c) b = ~ᵇ-Block c (~ᵇ₁-Block g b)
~ᵇ-Block (bwd g ◅ c) b = ~ᵇ-Block c (~ᵇ₁-Block⁻ g b)

------------------------------------------------------------------------
-- The reduced open core.
------------------------------------------------------------------------

-- OPEN.  Two block forms that are `~`-related are `~ᵇ`-related.
--
--   Why it should be true.  A `~` derivation induces (Normal.Witness) a
--   name bijection + thread permutation, and every generator moves whole
--   slots, so the bijection matches ν pairs to ν pairs and φ cells to
--   equal-flagged φ cells.  Between two BLOCK forms such a correspondence
--   is generated by block permutations and within-block adjustments: the
--   apparent extra power of `~` — migrating a φ from one block's run to
--   another's — is already `~ᵇ`-expressible, because blocks are anonymous:
--   transposing two blocks with unequal runs re-attaches every run cell
--   (e.g. `[ν][νφ] ~ᵇ [νφ][ν]` by one `bswpᵇ`, which is the same telescope
--   move as `perm-νφ` there, only with a different — and `ν1ᵇ`/`φφᵇ`/
--   `bswpᵇ`-correctable — thread renaming).
--
--   What a proof needs.  Induction on the number of blocks: locate the
--   first block of N₂ inside N₁, bring it to the front by `bswpᵇ` steps,
--   cancel the two heads, recurse.  Both remaining steps are exactly the
--   two known walls of the normal-form theory:
--     * LOCATE needs the slot correspondence of the `~` derivation as
--       data (an enrichment of `Witness` recording that the bijection is
--       slot-structured — ν pairs to ν pairs, order-free);
--     * CANCEL is head-block cancellation, `prefixNF B N₁ ~ prefixNF B N₂
--       → N₁ ~ N₂` for a whole block `B` up to the head renaming, i.e.
--       precisely the ν-level analogue of the φ-injectivity that
--       Backward/TelCong could not bottom out.
--   Neither is a design change; both are (large) inductions on derivations.
BlockBridge : Set
BlockBridge = ∀ {n} {N₁ N₂ : NF n} →
              Block (tel N₁) → Block (tel N₂) → N₁ ~ N₂ → N₁ ~ᵇ N₂

------------------------------------------------------------------------
-- The factorisation.
------------------------------------------------------------------------

-- The count hypothesis `blockify` wants, extracted from the block form on
-- the other side of the `~`.
blockHyp : ∀ {n} {N M : NF n} → Block (tel M) → N ~ M →
           νcountᵗ (tel N) ≡ 0 → φcountᵗ (tel N) ≡ 0
blockHyp {M = mkNF _ _} bnil r z = ~-φcountᵗ r
blockHyp {M = mkNF _ _} bν   r z with sym (~-νcountᵗ r) ■ z
... | ()

-- The factorisation, modulo `BlockBridge`: block-form the source by `~ᵩ`
-- alone (`blockify`), then bridge the two block forms by block moves.
factor : BlockBridge → ∀ {n} {N M : NF n} → Block (tel M) → N ~ M →
         Σ[ M′ ∈ NF n ] Block (tel M′) × (N ~ᵩ M′) × (M′ ~ᵇ M)
factor bridge {N = N} {M = M} bM r with blockify N (blockHyp bM r)
... | M′ , bM′ , c = M′ , bM′ , c , bridge bM′ bM (~-trans (~-sym (~ᵩ⇒~ c)) r)

------------------------------------------------------------------------
-- `BlockBridge` holds on the φ-free fragment.
------------------------------------------------------------------------

-- With no φ cells anywhere — an invariant of `~` (`~-φcountᵗ`) — every
-- telescope is block form, the two φ generators can never fire, and the
-- two ν-reindexing generators are directly block moves: `perm-ν1` is
-- `ν1ᵇ`, and `perm-νν` is `bswpᵇ` with two empty runs (same telescope,
-- same renaming: `bswapRen [] rnil t ≗ liftId t (assocSwapᵣ 2 2)`).  So
-- the single open piece of `factor` is precisely about φ-cell migration.

private
  noφ : ∀ m n {A : Set} → m + suc n ≡ 0 → A
  noφ zero    n ()
  noφ (suc m) n ()

  +≡0ʳ : ∀ m n → m + n ≡ 0 → n ≡ 0
  +≡0ʳ zero    n eq = eq
  +≡0ʳ (suc m) n ()

φfree-Block : ∀ {n k} (t : Tel n k) → φcountᵗ t ≡ 0 → Block t
φfree-Block []       _ = bnil
φfree-Block (tν t)   _ = bν
φfree-Block (tφ f t) ()

~₁-φfree⇒~ᵇ : ∀ {n} {N₁ N₂ : NF n} → φcountᵗ (tel N₁) ≡ 0 → N₁ ~₁ N₂ → N₁ ~ᵇ N₂
~₁-φfree⇒~ᵇ z (perm-ν1 s t es) = Eq*.return (ν1ᵇ s t es)
~₁-φfree⇒~ᵇ z (perm-νν s t es) =
  ~ᵇ-trans (Eq*.return (bswpᵇ s rnil rnil bt es))
           (≡→~ᵇ (cong (mkNF (s ++ᵗ tν (tν t))) (map-⋯-cong fix es)))
  where
    bt : Block t
    bt = φfree-Block t (+≡0ʳ (φcountᵗ s) (φcountᵗ t)
                             (sym (φcountᵗ-++ᵗ s (tν (tν t))) ■ z))

    fix : ∀ x → bswapRen [] rnil t x ≡ liftId t (assocSwapᵣ 2 2) x
    fix x = liftId-cong t (λ y → refl) x
~₁-φfree⇒~ᵇ z (perm-φφ s x y t es) =
  noφ (φcountᵗ s) (suc (φcountᵗ t)) (sym (φcountᵗ-++ᵗ s (tφ x (tφ y t))) ■ z)
~₁-φfree⇒~ᵇ z (perm-νφ s x t es) =
  noφ (φcountᵗ s) (φcountᵗ t) (sym (φcountᵗ-++ᵗ s (tν (tφ x t))) ■ z)
~₁-φfree⇒~ᵇ z (perm-thr t p)  = Eq*.return (thrᵇ t p)
~₁-φfree⇒~ᵇ z (unit-del t es) = Eq*.return (delᵇ t es)

φfree-bridge : ∀ {n} {N₁ N₂ : NF n} → φcountᵗ (tel N₁) ≡ 0 → N₁ ~ N₂ → N₁ ~ᵇ N₂
φfree-bridge z ε           = ~ᵇ-refl
φfree-bridge z (fwd g ◅ c) =
  ~ᵇ-trans (~₁-φfree⇒~ᵇ z g) (φfree-bridge (sym (~₁-φcountᵗ g) ■ z) c)
φfree-bridge z (bwd g ◅ c) =
  ~ᵇ-trans (~ᵇ-sym (~₁-φfree⇒~ᵇ (~₁-φcountᵗ g ■ z) g))
           (φfree-bridge (~₁-φcountᵗ g ■ z) c)
